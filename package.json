{
  "name": "applybro-backend",
  "version": "1.0.0",
  "description": "ApplyBro Modular Monolith Backend API (NestJS + Prisma + BullMQ)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "agent:setup": "node scripts/setup-cloud-agent.cjs",
    "agent:worker": "node scripts/cloud-worker.cjs",
    "agent:check": "node scripts/agent-preflight.cjs",
    "agent:connection-smoke": "node scripts/naukri-connection-smoke.cjs",
    "agent:test": "node --test scripts/cloud-agent.test.cjs scripts/cloud-browser.test.cjs scripts/agent-pacing.test.cjs scripts/naukri-flow.test.cjs scripts/naukri-workflow.test.cjs scripts/naukri-discovery.test.cjs",
    "agent:smoke": "node scripts/cloud-agent-smoke.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@nestjs/bullmq": "^10.1.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.3.0",
    "@prisma/client": "^5.14.0",
    "@types/multer": "^2.3.0",
    "bullmq": "^5.7.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^14.5.1",
    "multer": "^2.5.0",
    "playwright": "1.65.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "prisma": "^5.14.0",
    "typescript": "^5.1.3"
  }
}
