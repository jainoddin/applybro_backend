# ApplyBro Backend Environment Configuration

# 1. PostgreSQL Database Connection (Supabase / Neon / AWS RDS / Local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/applybro?schema=public"
# Neon CLI also supplies this direct connection for migrations and pg_dump/restore.
# Keep DATABASE_URL pooled for application traffic. Do not commit real URLs.
DATABASE_URL_UNPOOLED="postgresql://postgres:password@localhost:5432/applybro?schema=public"

# 2. Cloudflare R2 S3-Compatible Object Storage
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_api_token_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_api_token_secret_access_key"
R2_BUCKET_NAME="applybro-assets"
R2_PUBLIC_URL="https://pub-your_bucket_id.r2.dev" # or https://cdn.applybro.com

# 3. Server Configuration
PORT=4000
FRONTEND_URL="http://localhost:3000"


# Image uploads fail explicitly if R2 or its public URL cannot be verified.
# Use R2 S3 API Access Key ID + Secret Access Key, not a Cloudflare bearer token.
# Give the key Object Read & Write access to R2_BUCKET_NAME.
# Enable the bucket public development URL or configure its public custom domain.

# Free FormSubmit destination. Verify the activation email before receiving messages.
CONTACT_TO_EMAIL=helloapplybro@gmail.com

# Optional explicit regional endpoint and isolated prefix for a shared bucket:
# R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
R2_PREFIX=applybro

# Firebase server verification (private JSON file; never put keys in NEXT_PUBLIC settings)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Private browser login persistence. Generate once; preserve across restarts.
NAUKRI_SESSION_KEY=
# On hosted deployments use an attached private persistent disk:
# NAUKRI_SESSION_DIR=/var/data/naukri-sessions
# Approved WhatsApp utility template, two body variables: portal label and request ID.
WHATSAPP_OTP_TEMPLATE_NAME=

# Desktop browser AI next-step planner; uses existing Gemini configuration.
COMPANION_AI_PLANNER_ENABLED=false
CLOUD_AGENT_MODEL=
CLOUD_AGENT_API_KEY=
