# Merge into private backend-api/.env. Never commit real credentials.
# Keep disabled until browser isolation, HTTPS and allowed employer sites are ready.
CLOUD_AGENT_ENABLED=false
CLOUD_AGENT_MODEL=gemini-3.5-flash-lite
# Optional separate API key; otherwise the existing first GEMINI_API_KEYS key is used.
CLOUD_AGENT_API_KEY=
# Generated by npm run agent:setup. Back up this key privately; never rotate casually.
CLOUD_AGENT_ENCRYPTION_KEY=
CLOUD_AGENT_ALLOWED_HOSTS=job-boards.greenhouse.io,boards.greenhouse.io,jobs.lever.co,jobs.eu.lever.co
CLOUD_AGENT_PUBLIC_ORIGIN=https://your-applybro-domain.example
CLOUD_AGENT_CONCURRENCY=1
# Sequential per-user jobs; random review floor, never a forced-submit timeout.
CLOUD_AGENT_REVIEW_MIN_SECONDS=240
CLOUD_AGENT_REVIEW_MAX_SECONDS=480
# Local development: path to a separate browser executable, NOT your personal profile.
CLOUD_AGENT_CHROME_PATH=
# Deployment uses a private browser server; never expose this WebSocket publicly.
CLOUD_AGENT_BROWSER_WS=
RESEND_API_KEY=
CLOUD_AGENT_EMAIL_FROM=ApplyBro <verification@your-verified-domain.example>

# Legacy local automatic batches are disabled by default after migration.
COMPANION_AUTO_APPLY_ENABLED=false
